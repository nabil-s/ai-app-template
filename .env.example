# Copy to .env (git-ignored) and run with: uv run --env-file .env <command>
# Never commit real keys. In CI, keys come from GitHub Actions secrets.

# ollama (free, local - default) | anthropic (paid)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

TELEMETRY_PATH=.telemetry/calls.jsonl
